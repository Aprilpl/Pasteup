<!--
  设置窗口：复刻原型 .settings 结构（外框 + 标题栏 + 横向标签 + 内嵌纸面分区）。
  分区：通用 / 热键 / 贴图 / 历史 / 关于；开关=SwitchCheckBox、按钮=胶囊、数字=文本框（失焦校正）。
  非分层不透明窗：窗口矩形 == 可见卡片（无阴影画布透明环，整窗可命中无需 #01 补丁）；
  圆角与阴影交给系统——DWMWCP_ROUND + EnableDwmShadow，CardRadius=8 与系统固定圆角 DIP 恒等。
-->
<Window x:Class="Pasteup.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:svc="clr-namespace:Pasteup.App.Services"
        Title="Pasteup 设置" Width="940" MinWidth="880" MinHeight="480" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource FrameBrush}"
        FontFamily="{DynamicResource FontSans}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SecTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="SecDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeDesc}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeNote}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <!-- 行标签列被右侧固定宽控件挤压时优雅省略，不硬裁（窗口 MinWidth 已保证常态完整） -->
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="NumInput" TargetType="TextBox" BasedOn="{StaticResource BareInput}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeDesc}"/>
        </Style>
        <!-- 设置页标签：五等分整行，整格可点（共享 TabButton 为内容自适应，唤起面板仍在用） -->
        <Style x:Key="SettingsTab" TargetType="Button" BasedOn="{StaticResource TabButton}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0,8,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="{DynamicResource CardRadius}"
            Background="{DynamicResource FrameBrush}"
            BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1">
        <!-- 圆角裁剪：Border.CornerRadius 不裁子元素，贴角的标题栏按钮悬停底色会画出圆角框外成直角 -->
        <Grid svc:RoundedClip.Enabled="True"
              svc:RoundedClip.Radius="{DynamicResource CardRadius}">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：非交互区可拖动（WindowDragging 接管） + 关闭 -->
            <Grid Grid.Row="0" Background="Transparent">
                <TextBlock Text="设置" Margin="18,0,0,0" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitlebarButton}" Click="OnClose" ToolTip="关闭">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 横向标签：五等分等宽，整格即点击区 -->
            <Grid Grid.Row="1" Margin="24,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="TabGeneral" Style="{StaticResource SettingsTab}" Tag="Active" Click="OnNavGeneral" Content="通用"/>
                <Button Grid.Column="1" x:Name="TabHotkeys" Style="{StaticResource SettingsTab}" Click="OnNavHotkeys" Content="热键"/>
                <Button Grid.Column="2" x:Name="TabPin" Style="{StaticResource SettingsTab}" Click="OnNavPin" Content="贴图"/>
                <Button Grid.Column="3" x:Name="TabHistory" Style="{StaticResource SettingsTab}" Click="OnNavHistory" Content="历史"/>
                <Button Grid.Column="4" x:Name="TabAbout" Style="{StaticResource SettingsTab}" Click="OnNavAbout" Content="关于"/>
            </Grid>

            <!-- 纸面（左右 padding 对称 28：原型 4px 左距实机观感贴边，弃用） -->
            <Border Grid.Row="2" Margin="8,8,8,8" CornerRadius="{DynamicResource SheetRadius}"
                    Background="{DynamicResource SheetBrush}" BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1" Padding="28,28,28,26">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- ===== 通用 ===== -->
                        <StackPanel x:Name="PageGeneral">
                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="外观" Style="{StaticResource SecTitle}"/>
                                    <TextBlock Text="应用界面主题；跟随系统将随 Windows 深浅色自动切换。" Style="{StaticResource SecDesc}" Margin="0,7,28,0"/>
                                </StackPanel>
                                <Border Background="{DynamicResource PanelBrush}"
                                        CornerRadius="{DynamicResource CardRadius}" Padding="16,4" Grid.Column="1">
                                    <StackPanel>
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 行标签列定最小/最大宽：窄窗不被右侧按钮挤到裁字（窗口 MinWidth=880 按此行最宽需求推算） -->
                                            <StackPanel MinWidth="180" MaxWidth="420">
                                                <TextBlock Text="主题" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="浅色 = 框中纸 · 深色 = 数据终端" Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <!-- 三钮统一 MinWidth=96：按最长文案「跟随系统」（4 字 ≈50px + 左右 Padding 30 + 描边 2）留出余量 -->
                                            <Button Grid.Column="1" x:Name="ThemeLight" Click="OnThemePick" Tag="opt" Margin="0,0,8,0" MinWidth="96"
                                                    Content="浅色"/>
                                            <Button Grid.Column="2" x:Name="ThemeDark" Click="OnThemePick" Tag="opt" Margin="0,0,8,0" MinWidth="96"
                                                    Content="深色"/>
                                            <Button Grid.Column="3" x:Name="ThemeSystem" Click="OnThemePick" Tag="opt" MinWidth="96"
                                                    Content="跟随系统"/>
                                        </Grid>
                                        <Separator/>
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="选中即粘贴" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="回车确认后自动向目标窗口发送 Ctrl+V。" Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}"
                                                      IsChecked="{Binding Vm.PasteOnEnter, Mode=TwoWay}"/>
                                        </Grid>
                                        <Separator/>
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="唤起面板时回到顶部" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="每次唤起都从最新内容开始，不再保留上次翻找的位置。" Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}"
                                                      IsChecked="{Binding Vm.SummonResetToTop, Mode=TwoWay}"/>
                                        </Grid>
                                        <Separator/>
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="面板锚点" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="跟随光标 = 贴文本插入光标弹在下方；取不到光标（部分自绘界面）时退回鼠标。" Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" x:Name="AnchorCaret" Click="OnAnchorPick" Tag="opt"
                                                    Margin="0,0,8,0" MinWidth="96" Content="跟随光标"/>
                                            <Button Grid.Column="2" x:Name="AnchorCursor" Click="OnAnchorPick" Tag="opt"
                                                    MinWidth="96" Content="跟随鼠标"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- ===== 热键 ===== -->
                        <StackPanel x:Name="PageHotkeys" Visibility="Collapsed">
                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="全局热键" Style="{StaticResource SecTitle}"/>
                                    <TextBlock Text="点击右侧胶囊后直接按下新组合键；与其他程序冲突时不会生效。" Style="{StaticResource SecDesc}" Margin="0,7,28,0"/>
                                </StackPanel>
                                <Border Background="{DynamicResource PanelBrush}" CornerRadius="{DynamicResource CardRadius}"
                                        Padding="16,4" Grid.Column="1">
                                    <StackPanel>
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="唤起面板" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="显示 / 隐藏剪贴板历史面板。" Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <Button x:Name="HkInvoke" Grid.Column="1" Click="OnRecordInvoke" MinWidth="170"
                                                    FontFamily="{DynamicResource FontMono}" Content="{Binding Vm.InvokeHotkeyDisplay}"/>
                                        </Grid>
                                        <Separator/>
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="截图并贴图" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="拖拽选区，松开即贴到屏幕。" Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <Button x:Name="HkShot" Grid.Column="1" Click="OnRecordShot" MinWidth="170"
                                                    FontFamily="{DynamicResource FontMono}" Content="{Binding Vm.ScreenshotHotkeyDisplay}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- ===== 贴图 ===== -->
                        <StackPanel x:Name="PagePin" Visibility="Collapsed">
                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="贴图" Style="{StaticResource SecTitle}"/>
                                    <TextBlock Text="贴图窗口的默认行为。滚轮缩放、Ctrl+滚轮透明度、F9 点击穿透随时可用。" Style="{StaticResource SecDesc}" Margin="0,7,28,0"/>
                                </StackPanel>
                                <Border Background="{DynamicResource PanelBrush}" CornerRadius="{DynamicResource CardRadius}"
                                        Padding="16,4" Grid.Column="1">
                                    <StackPanel>
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="默认透明度" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="0.2 – 1.0，例如 1 = 不透明。" Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Style="{StaticResource NumInput}"
                                                     LostFocus="OnOpacityInput" Text="{Binding Vm.PinDefaultOpacity, StringFormat=F2, Mode=OneWay}"/>
                                        </Grid>
                                        <Separator/>
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="缩放步进（%）" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="滚轮一格的缩放比例，默认 10。" Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Style="{StaticResource NumInput}"
                                                     LostFocus="OnZoomInput" Text="{Binding Vm.PinZoomStepPercent, Mode=OneWay}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- ===== 历史 ===== -->
                        <StackPanel x:Name="PageHistory" Visibility="Collapsed">
                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="历史记录" Style="{StaticResource SecTitle}"/>
                                    <TextBlock Text="容量与保留期同时生效；置顶条目不会被自动清理。" Style="{StaticResource SecDesc}" Margin="0,7,28,0"/>
                                </StackPanel>
                                <Border Background="{DynamicResource PanelBrush}" CornerRadius="{DynamicResource CardRadius}"
                                        Padding="16,4" Grid.Column="1">
                                    <StackPanel>
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="最大条数" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="超出后从最旧端移除（置顶豁免）。" Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Style="{StaticResource NumInput}"
                                                     LostFocus="OnCapacityInput" Text="{Binding Vm.HistoryCapacity, Mode=OneWay}"/>
                                        </Grid>
                                        <Separator/>
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="保留天数" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="到期自动清理非置顶条目。" Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Style="{StaticResource NumInput}"
                                                     LostFocus="OnRetentionInput" Text="{Binding Vm.RetentionDays, Mode=OneWay}"/>
                                        </Grid>
                                        <Separator/>
                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="退出时清空历史" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="包括本地缓存图像文件。" Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}"
                                                      IsChecked="{Binding Vm.ClearHistoryOnExit, Mode=TwoWay}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- ===== 关于 ===== -->
                        <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="关于" Style="{StaticResource SecTitle}"/>
                                    <TextBlock Text="Pasteup — 截图 / 贴图 / 剪贴板历史。" Style="{StaticResource SecDesc}" Margin="0,7,28,0"/>
                                </StackPanel>
                                <Border Background="{DynamicResource PanelBrush}" CornerRadius="{DynamicResource CardRadius}"
                                        Padding="16,10" Grid.Column="1">
                                    <StackPanel Margin="0,6,0,10">
                                        <TextBlock Text="{Binding Vm.VersionText}" FontFamily="{DynamicResource FontMono}"
                                                   FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Content="打开数据目录" Click="OnOpenDataDir" Width="110"/>
                                            <Button Content="清空历史" Click="OnClearHistory" Margin="10,0,0,0" Width="96"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 模态压暗遮罩：清空确认对话框 ShowDialog 期间盖住设置窗内容（原型 #scrim） -->
            <Border x:Name="ModalScrim" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
                    IsHitTestVisible="False" Background="{DynamicResource ModalScrimBrush}"/>
            </Grid>
    </Border>
</Window>
