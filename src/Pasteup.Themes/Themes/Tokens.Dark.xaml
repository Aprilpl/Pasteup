<!--
  深色主题 · 数据终端
  源：docs/prototypes/css/pasteup.css 的 :root[data-theme="dark"] 段（1:1 映射，键名后括注原 CSS 变量）。
  结构：外框即页面底，纸面比底更深一层（卡片沉降感）；品牌蓝 #4a8ad6。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ========== 表面结构 ========== -->
  <SolidColorBrush x:Key="FrameBrush"      Color="#171719"/>  <!-- css:frame 外框 = 页面底 -->
  <SolidColorBrush x:Key="SheetBrush"      Color="#131217"/>  <!-- css:sheet 纸面比底更深一层 -->
  <SolidColorBrush x:Key="PanelBrush"      Color="#212023"/>  <!-- css:panel 抬升面 -->
  <SolidColorBrush x:Key="RowHoverBrush"   Color="#1A191E"/>  <!-- css:row-hover -->
  <SolidColorBrush x:Key="RowHoverFaintBrush" Color="#8C1A191E"/> <!-- 行悬停极淡底：55% row-hover 预混 -->
  <Color x:Key="RowLiftShadowColor">#80000000</Color> <!-- 行悬停浮起阴影色：css 0 4px 16px rgba(0,0,0,.5)；dark 黑影贴深底弱故以淡底为主；效果实例在 Tokens.Base -->
  <SolidColorBrush x:Key="EdgeBrush"       Color="#2A2A2E"/>  <!-- css:edge -->
  <SolidColorBrush x:Key="RuleBrush"       Color="#1B1A1F"/>  <!-- css:rule -->
  <SolidColorBrush x:Key="PopupBorderBrush" Color="#0E0E10"/> <!-- css:popup-border -->
  <SolidColorBrush x:Key="WinHoverBrush"   Color="#212023"/>  <!-- css:win-hover -->
  <SolidColorBrush x:Key="ScrimBrush"      Color="#8C000000"/> <!-- 截图覆盖层遮罩（55% 黑，功能性 UI，无原型对应） -->

  <!-- ========== 文本 ========== -->
  <SolidColorBrush x:Key="TextBrush"       Color="#FFFFFF"/>  <!-- css:text -->
  <SolidColorBrush x:Key="MutedBrush"      Color="#9A9CA2"/>  <!-- css:muted -->

  <!-- ========== 品牌 ========== -->
  <SolidColorBrush x:Key="AccentBrush"     Color="#4A8AD6"/>  <!-- css:accent 品牌蓝 -->
  <SolidColorBrush x:Key="AccentTintBrush" Color="#1E2B3D"/>  <!-- css:accent-tint 选中行深蓝底 -->
  <SolidColorBrush x:Key="TabHoverLineBrush" Color="#2E4B6E"/> <!-- 标签悬停预告线：45% accent 预混入 frame（45% #4A8AD6 + 55% #171719） -->

  <!-- ========== 危险（css: danger，仅破坏性操作使用） ========== -->
  <SolidColorBrush x:Key="DangerBrush"       Color="#E5695E"/>  <!-- css:danger 危险红：清空确认钮 -->
  <SolidColorBrush x:Key="DangerStrongBrush" Color="#EE8177"/>  <!-- css:danger-strong 危险钮悬停 -->
  <SolidColorBrush x:Key="DangerInkBrush"    Color="#131217"/>  <!-- css:danger-ink 红底配近黑墨（白字对比 3.2:1 不达标） -->
  <SolidColorBrush x:Key="ModalScrimBrush"   Color="#570A0C0E"/> <!-- 模态压暗遮罩 34% 黑（原型页 #scrim，无组件对应） -->

  <!-- ========== 控件 ========== -->
  <SolidColorBrush x:Key="ControlBgBrush"      Color="#212023"/>  <!-- css:control-bg -->
  <SolidColorBrush x:Key="ControlBorderBrush"  Color="#3A3A3E"/>  <!-- css:control-border -->
  <SolidColorBrush x:Key="KbdBgBrush"          Color="#212023"/>  <!-- css:kbd-bg -->
  <SolidColorBrush x:Key="KbdBorderBrush"      Color="#2A2A2E"/>  <!-- css:kbd-border -->
  <SolidColorBrush x:Key="KbdTextBrush"        Color="#C6C7CB"/>  <!-- css:kbd-text -->
  <SolidColorBrush x:Key="ChipBgBrush"         Color="#D10E0E10"/>  <!-- css:chip-bg rgba(14,14,16,.82) -->
  <SolidColorBrush x:Key="ChipTextBrush"       Color="#ECEDED"/>    <!-- css:chip-text -->
  <SolidColorBrush x:Key="ChipBorderBrush"     Color="Transparent"/> <!-- css:chip-border: transparent -->
  <SolidColorBrush x:Key="SwitchOffTrackBrush" Color="#3A3A3E"/>  <!-- css:switch-off-track -->
  <SolidColorBrush x:Key="SwitchOffKnobBrush"  Color="#B9BABD"/>  <!-- css:switch-off-knob -->
  <SolidColorBrush x:Key="SwitchOnTrackBrush"  Color="#E9E9EB"/>  <!-- css:switch-on-track 浅轨反转 -->
  <SolidColorBrush x:Key="SwitchOnKnobBrush"   Color="#171719"/>  <!-- css:switch-on-knob -->

</ResourceDictionary>
